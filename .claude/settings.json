{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Bash",
      "PowerShell",
      "Bash(bash scripts/trigger_publish.sh*)"
    ],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/auto_preview.py\"",
            "timeout": 180,
            "statusMessage": "檢查 input/ 有沒有新照片..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/auto_preview.py\"",
            "timeout": 180,
            "statusMessage": "檢查 input/ 有沒有新照片..."
          }
        ]
      }
    ]
  }
}
